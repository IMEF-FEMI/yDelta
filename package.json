{
  "name": "@ydelta/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for yDelta — quote-only fixed-rate lending on Solana",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/",
    "ts/idl/",
    "ts/src/",
    "ts/README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write 'ts/**/*.ts' 'ts/**/*.json'",
    "lint": "eslint 'ts/**/*.ts'",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mrgnlabs/marginfi-client-v2": "^6.4.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "@switchboard-xyz/on-demand": "^2.14.4",
    "bn.js": "^5.2.1",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "solana-bankrun": "^0.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "useTabs": false,
    "bracketSpacing": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
