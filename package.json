{
  "name": "@ydelta/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for yDelta — fixed-term, quote-based lending on Solana, marginfi-backed",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/IMEF-FEMI/yDelta.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/IMEF-FEMI/yDelta#readme",
  "bugs": "https://github.com/IMEF-FEMI/yDelta/issues",
  "keywords": [
    "solana",
    "ydelta",
    "lending",
    "fixed-rate",
    "marginfi",
    "defi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "@solana/web3.js@npm:1.77.4/rpc-websockets": "7.5.1"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/",
    "ts/idl/",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "prepublishOnly": "yarn build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write 'ts/**/*.ts' 'ts/**/*.json'",
    "lint": "eslint 'ts/**/*.ts'",
    "test": "vitest run",
    "clean": "rimraf dist",
    "deploy": "tsx ts/scripts/deploy.ts",
    "create-global-config": "tsx ts/scripts/create-global-config.ts",
    "create-curators": "tsx ts/scripts/create-curators.ts",
    "create-vault": "tsx ts/scripts/create-vault.ts",
    "setup-curator-profiles": "tsx ts/scripts/setup-curator-profiles.ts",
    "init-market": "tsx ts/scripts/init-market.ts",
    "create-market-lut": "tsx ts/scripts/create-market-lut.ts",
    "bootstrap": "tsx ts/scripts/bootstrap.ts",
    "vault:deposit": "tsx ts/scripts/vault-deposit.ts",
    "vault:withdraw": "tsx ts/scripts/vault-withdraw.ts",
    "vault:place-ask": "tsx ts/scripts/vault-place-ask.ts",
    "vault:cancel-order": "tsx ts/scripts/vault-cancel-order.ts",
    "seat:deposit": "tsx ts/scripts/seat-deposit.ts",
    "seat:withdraw": "tsx ts/scripts/seat-withdraw.ts",
    "borrower:place-bid": "tsx ts/scripts/borrower-place-bid.ts",
    "borrower:repay": "tsx ts/scripts/borrower-repay.ts",
    "borrower:convert-p2pool": "tsx ts/scripts/borrower-convert-p2pool.ts",
    "settle": "tsx ts/scripts/settle.ts",
    "liquidate": "tsx ts/scripts/liquidate.ts",
    "claim-repayment": "tsx ts/scripts/claim-repayment.ts",
    "claim-curator-fee": "tsx ts/scripts/claim-curator-fee.ts",
    "crank-matched-loan": "tsx ts/scripts/crank-matched-loan.ts",
    "crank-oracle": "tsx ts/scripts/crank-oracle.ts",
    "set-fee-config": "tsx ts/scripts/set-fee-config.ts",
    "set-market-pause": "tsx ts/scripts/set-market-pause.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@mrgnlabs/marginfi-client-v2": "^6.4.1",
    "@pythnetwork/pyth-solana-receiver": "^0.8.0",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "@switchboard-xyz/common": "^4.1.11",
    "@switchboard-xyz/on-demand": "^2.14.4",
    "bn.js": "^5.2.1",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "solana-bankrun": "^0.4.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "useTabs": false,
    "bracketSpacing": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
