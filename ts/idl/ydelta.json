{
  "version": "0.1.0",
  "name": "ydelta",
  "programId": "Ar38x7KobxmwvKwSL2VzdjFxrtXd3Gs2VfB3ZCakyJas",
  "description": "Quote-only fixed-rate lending on Solana. 45 instructions, tags 0..=44. Instruction data is borsh-encoded after a 1-byte tag header. State accounts are bytemuck `#[repr(C)]` Pod — NOT borsh — so account decoders live in `ts/src/accounts/` and read raw byte offsets. v1 adds a two-sided order book: borrowers rest bids (tags 42/44 cancel/update, tag 4 residual-mode rest) and sub-vaults rest asks (tags 12/14), crossed by a permissionless match crank (tag 43).",
  "conventions": {
    "instructionDataHeader": "1-byte u8 tag (see `tag` per instruction). Tail is borsh-encoded except for `SettleMaturedLoan` and `LiquidateLoan`, whose tail is a bare little-endian u64 (`repay_atoms_max`).",
    "amounts": "All atoms are bigint at the wire level. All bps fields are u16. All term_seconds are u32. All u128 fields (shares, fp48 share-values) are LE 16 bytes. `sub_vault_id` is u16 everywhere (v1 widened it from u8).",
    "computeBudget": "Heavy ixs (`PlaceOrder`, `ProcessMatchedLoan` with vaultSettle, `LiquidateLoan`, `SettleMaturedLoan`, `ClaimRepaymentForSubVault`, `MatchCrank`) need `ComputeBudgetProgram.setComputeUnitLimit(600_000)` prepended."
  },
  "instructions": [
