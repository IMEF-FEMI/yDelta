    {
      "name": "MarketFixed",
      "size": 512,
      "encoding": "bytemuck Pod (raw byte layout — NOT borsh)",
      "discriminator": "u64 at offset 0 (MARKET_FIXED_DISCRIMINANT)",
      "note": "Account is `MarketFixed` header + variable-length dynamic region holding the asks RB-tree, claimed-seats RB-tree, matched-loans RB-tree, and free list. See `programs/ydelta/src/state/market.rs` for byte-offset comments. Decoder lives at ts/src/accounts/market.ts (Phase 3)."
    },
    { "name": "GlobalConfig", "encoding": "bytemuck Pod", "note": "Holds `protocol_admin`, `pending_protocol_admin`, `is_paused`. See state/global_config.rs." },
    { "name": "GlobalVaultFixed", "size": 320, "encoding": "bytemuck Pod", "note": "Per-mint vault header. Dynamic region holds the sub_vaults RB-tree (496-byte payloads) and claimed_seats + market_orders RB-trees backed by node blocks carrying 144-byte payloads. sub_vault_count is u16; next_sub_vault_id is u16. See state/vault.rs." },
    { "name": "SubVault", "size": 496, "encoding": "bytemuck Pod tree-node payload", "note": "Keyed by sub_vault_id (u16, 1-based; 0 is sentinel). Carries is_sunset flag at offset 2, kind at offset 3 (0=Pool, 1=Private), spread_bps at offset 4, explicit max_ltv_bps/liquidation_ltv_bps at offsets 40/42, curator_fee_bps at offset 48, and pending_claim_atoms (retired atoms awaiting claim_repayment_for_sub_vault sweep) at offset 240. See state/vault.rs." },
    { "name": "SubVaultDepositorSeat", "size": 144, "encoding": "bytemuck Pod tree-node payload", "note": "Keyed by (owner, sub_vault_id u16). Carries shares + supply/delta yield-index snapshots." },
    { "name": "SubVaultOrderRef", "size": 144, "encoding": "bytemuck Pod tree-node payload", "note": "Keyed by (market, sub_vault_id u16). At most one live order per (sub_vault, market)." },
    { "name": "ClaimedSeat", "encoding": "bytemuck Pod tree-node payload", "note": "Per-trader bookkeeping in a market — debt/collateral × withdrawable/encumbered shares + matched-loan running aggregates. owner_kind at offset 104 (0=User, 1=SubVault); sub_vault_id u16 at offset 106." },
    { "name": "RestingOrder", "size": 144, "encoding": "bytemuck Pod tree-node payload", "note": "Order body — rate_bps, term_seconds, sequence, last_valid_unix_ts (i64 at offset 32), side, order_type, ltv_buffer_bps (u16 at offset 66 — borrower LTV buffer; persists on a rested bid so a later cross honors the same effective_cap)." },
    { "name": "MatchedLoan", "size": 144, "encoding": "bytemuck Pod tree-node payload", "note": "Transient queue node between match and promote. Carries curator_fee_bps_snapshot / origination_ltv_bps / liquidation_ltv_bps at offsets 88/90/92." },
    { "name": "LoanFixed", "encoding": "bytemuck Pod PDA", "note": "Per-loan PDA seeded by (b\"loan\", market, sequence_le). Carries origination_ltv_bps/liquidation_ltv_bps at 96/98 and lender_sub_vault_id (u16) at 202." },
    { "name": "UserAccount", "encoding": "bytemuck Pod", "note": "Per-wallet market-position + vault-position mirrors plus the resting-bid UserOrderRef tree (open_orders_root_index at offset 72, user_order_count at offset 76). Authoritative balances live on the canonical ClaimedSeat / SubVaultDepositorSeat trees." }
