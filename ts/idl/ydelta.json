{
  "version": "0.1.0",
  "name": "ydelta",
  "programId": "A1fNwJV5C2BTKWcnHmaELNq2TLB11UP7mp9P7q4ahWnu",
  "description": "Quote-only fixed-rate lending on Solana. 37 instructions, tags 0..=36. Instruction data is borsh-encoded after a 1-byte tag header. State accounts are bytemuck `#[repr(C)]` Pod — NOT borsh — so account decoders live in `ts/src/accounts/` (Phase 3) and read raw byte offsets.",
  "conventions": {
    "instructionDataHeader": "1-byte u8 tag (see `tag` per instruction). Tail is borsh-encoded except for `SettleMaturedLoan` and `LiquidateLoan`, whose tail is a bare little-endian u64 (`repay_atoms_max`).",
    "amounts": "All atoms are bigint at the wire level. All bps fields are u16. All term_seconds are u32. All u128 fields (shares, fp48 share-values) are LE 16 bytes.",
    "computeBudget": "Heavy ixs (`PlaceOrder`, `ProcessMatchedLoan` with vaultSettle, `LiquidateLoan`, `SettleMaturedLoan`, `ClaimRepaymentForRiskProfile`) need `ComputeBudgetProgram.setComputeUnitLimit(600_000)` prepended."
  },
  "instructions": [
