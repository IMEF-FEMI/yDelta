# yDelta setup-script environment overrides.
#
# Copy this file to `.env` (gitignored) and fill in real values.
# Variables here supply DEFAULTS for setup-script CLI flags; an explicit
# CLI flag still wins. The scripts call `loadDotEnv()` at startup.
#
# Precedence:   CLI flag  >  process.env  >  .env  >  hardcoded default

# -------- Cluster selection --------
# Either a shorthand (localhost, devnet, mainnet-beta) or a full RPC URL.
# Honored when `--cluster` is omitted.
YDELTA_CLUSTER=mainnet-beta

# Custom RPC URL that overrides the shorthand→URL map for the matching
# cluster name. Useful for Helius / Triton / QuickNode etc.
YDELTA_RPC_URL=https://your-rpc-provider.example.com/?api-key=xxx

# -------- Keypairs (paths, not raw secrets) --------
# Default --payer path. Defaults to ~/.config/solana/id.json if unset.
YDELTA_PAYER_KEYPAIR=/absolute/path/to/payer.json

# Separate upgrade-authority keypair. If unset, deploy.ts falls back to
# YDELTA_PAYER_KEYPAIR and prints a warning on mainnet.
YDELTA_UPGRADE_AUTHORITY_KEYPAIR=/absolute/path/to/upgrade-authority.json

# -------- Mainnet confirmation --------
# Set to `1` to skip the typed-phrase confirmation prompt (CI / automation).
# Equivalent to --confirm-mainnet on the CLI.
YDELTA_CONFIRM_MAINNET=
