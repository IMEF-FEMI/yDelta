# ─────────── Cluster ───────────
YDELTA_RPC_URL=https://your-rpc-provider.example.com/?api-key=xxx

# ─────────── Signer keypair ───────────
YDELTA_DEPLOYER_KEYPAIR_PATH=/absolute/path/to/keypair.json
# YDELTA_KEYPAIR_PATH=/absolute/path/to/keypair.json
# YDELTA_UPGRADE_AUTHORITY_PUBKEY=YourUpgradeAuthorityPubkeyHere

# ─────────── Action-role keypairs (base58 secret keys) ───────────
YDELTA_DEPOSITOR_KEYPAIR_B58=<base58 secret key of the LP depositor>
YDELTA_BORROWER_KEYPAIR_B58=<base58 secret key of the borrower>

# ─────────── Local state directory ───────────
# YDELTA_LOCAL_DIR=/absolute/path/to/state-dir

# ─────────── Pyth Hermes endpoint ───────────
# YDELTA_HERMES_URL=https://hermes.pyth.network

# ─────────── Script knobs ───────────
# YDELTA_DEPLOY_ARGS="--yes"
# YDELTA_REGEN_CURATORS=1

# Self-hosted Switchboard Crossbar (see infra/crossbar/README.md) — escapes
# the rate-limited public infra. Optional; falls back to public crossbar.
YDELTA_SWITCHBOARD_CROSSBAR=
YDELTA_SWITCHBOARD_GATEWAY=
